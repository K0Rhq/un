  "description": "Build your docs in an Astro site, using unstyled docs primitives and schemas with all the functionality built in.",
  "homepage": "https://github.com/K0Rhq/un#readme",
  "repository": "https://github.com/K0Rhq/un",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "fix": "biome check --write .",
    "build": "tsup"
  },
  "keywords": [],
  "author": "dukc",
