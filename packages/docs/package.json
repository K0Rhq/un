  },
  "files": [
    "./dist",
    "./src/components",
    "LICENSE.txt"
  ],
  "dependencies": {
    "@types/react": "^19.1.8",
    "astro": "^5.9.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vite": "^5.4.19"
  }
