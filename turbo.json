{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["dist/**", "target/release/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "@korhq/undocs-example#dev": {
      "persistent": true,
      "cache": false,
      "dependsOn": ["@korhq/undocs#build"]
    },
    "fix": {
      "outputs": []
    }
  }
}
